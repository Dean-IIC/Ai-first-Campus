# Copy this file to .env.local and fill in the values from
# Supabase Dashboard > Project Settings > API Keys.

# Public values (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the publishable key (sb_publishable_...). The legacy anon key also works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Used ONLY by `npm run db:seed`. Never expose it.
# Use the secret key (sb_secret_...). The legacy service_role key also works:
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/revalidate (refreshes pages after edits in Supabase)
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Public site address, used for SEO metadata and the sitemap
NEXT_PUBLIC_SITE_URL=https://www.hkbk.edu.in

# --- Site admin (one account, signs in at /admin/login) ---
# ADMIN_EMAIL: the admin's email address.
ADMIN_EMAIL=
# ADMIN_PASSWORD_HASH: create it with `npm run admin:hash`. Keep the single quotes around it.
ADMIN_PASSWORD_HASH=''
# SESSION_SECRET: a random string of at least 32 characters, for example: openssl rand -hex 32
SESSION_SECRET=
